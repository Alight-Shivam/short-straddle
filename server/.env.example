# Copy this file to server/.env and fill in real values.
# Create an app at https://developer.upstox.com/ (Apps section) to get a
# client_id / client_secret, and register the exact redirect URI below there.

PORT=4000
NODE_ENV=development

# From your Upstox developer app:
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must match EXACTLY what's registered in the Upstox app settings, including
# http/https and trailing slash (or lack of one).
UPSTOX_REDIRECT_URI=http://localhost:4000/api/auth/callback

# The deployed (or local dev) frontend origin, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Any long random string — used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
